# Copy this file to `.env` next to it and fill in the values you have.
# `app/core/config.py` auto-loads `.env` on backend startup.

# --- Database -------------------------------------------------------------
# DATABASE_URL=sqlite:///./educopilot.db
# ENVIRONMENT=development
# CHROMA_PERSIST_DIR=/tmp/educopilot-chroma

# --- LLM provider routing -------------------------------------------------
# Comma-separated list. The first provider with valid credentials wins.
# Default: openrouter,anthropic,ollama
# LLM_PROVIDER_ORDER=openrouter,anthropic,ollama

# --- OpenRouter (PRIMARY) -------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_COMPLEX=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL_SIMPLE=anthropic/claude-haiku-4.5
# OPENROUTER_REFERER=http://localhost:3000
# OPENROUTER_TITLE=EduCopilot

# --- Anthropic native (FALLBACK when OpenRouter is unavailable) -----------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-5
# ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5

# --- Local Ollama (last resort) -------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b
# Thinking is disabled by the application. JSON tasks use a schema + one retry.
# Context and output budgets (tokens); large contexts consume more GPU memory.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=8192
# OLLAMA_KEEP_ALIVE=5m
# Essay grading uses temperature 0 and this seed (not a correctness guarantee).
# OLLAMA_GRADING_SEED=42

# --- Embeddings ----------------------------------------------------------
# Default keeps the existing Hugging Face embedding path.
# EMBEDDING_PROVIDER=huggingface
# To avoid Hugging Face downloads: `ollama pull bge-m3`, then:
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=bge-m3
# OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# CPU by default, so embedding does not compete with the chat model on 8 GB GPUs.
# OLLAMA_EMBEDDING_NUM_GPU=0
# Use a NEW CHROMA_PERSIST_DIR when switching provider/model; re-upload materials.
# Embedding calls unload the embedding model immediately (keep_alive=0).

# --- Startup, accounts and browser sessions -------------------------------
# The tracked sample DB is read-only input: copy it outside the repo first.
# Missing databases fail startup. Creation/seed require explicit CLI commands.
# DATABASE_URL=sqlite:////absolute/path/outside/repo/educopilot.db
# EDUCOPILOT_INIT_DB=false
# EDUCOPILOT_SEED_DEMO=false
# Bootstrap ONLY when there are no users. Supply both from your secret environment.
EDUCOPILOT_ADMIN_USERNAME=
EDUCOPILOT_ADMIN_PASSWORD=
# Alternative: `uv run python -m app.cli create-user --username ... --role admin`
# Password is prompted; EDUCOPILOT_ACCOUNT_PASSWORD is an optional CLI-only secret.
# Secure=true is required for HTTPS deployments. false is only for local HTTP.
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Session: HttpOnly + SameSite=Strict, expires after 8 hours; unsafe requests need Origin.
# Optional deployment label; default is a SHA-256 fingerprint of backend source.
# APPLICATION_VERSION=
